{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@sovereignsquad/gds-theme": ["packages/gds-theme/src/index.ts"],
      "@sovereignsquad/gds-core": ["packages/gds-core/src/index.ts"],
      "@sovereignsquad/gds-admin": ["packages/gds-admin/src/index.ts"],
      "@sovereignsquad/gds-a11y": ["packages/gds-a11y/src/index.ts"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
